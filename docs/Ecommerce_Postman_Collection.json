{
  "item": [
    {
      "description": "Lecturas públicas del catálogo de Odoo.",
      "item": [
        {
          "request": {
            "url": {
              "path": [
                "api",
                "products"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "raw": "{{baseUrl}}/api/products"
            },
            "method": "GET",
            "header": [],
            "description": "Lista el catálogo desde Odoo."
          },
          "name": "Listar productos"
        },
        {
          "request": {
            "url": {
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "value": "{{categoryId}}",
                  "key": "categoryId"
                }
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "raw": "{{baseUrl}}/api/products?categoryId={{categoryId}}"
            },
            "method": "GET",
            "header": [],
            "description": "Reemplaza categoryId por una categoría existente en tu Odoo."
          },
          "name": "Filtrar productos por categoría"
        },
        {
          "request": {
            "url": {
              "path": [
                "api",
                "products",
                "{{productId}}"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "raw": "{{baseUrl}}/api/products/{{productId}}"
            },
            "method": "GET",
            "header": [],
            "description": "Reemplaza productId por un producto existente."
          },
          "name": "Detalle de producto"
        },
        {
          "request": {
            "url": {
              "path": [
                "api",
                "products",
                "{{productId}}",
                "image"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "raw": "{{baseUrl}}/api/products/{{productId}}/image"
            },
            "method": "GET",
            "header": [],
            "description": "Puede responder 404 si el producto no tiene imagen válida."
          },
          "name": "Imagen de producto"
        },
        {
          "request": {
            "url": {
              "path": [
                "api",
                "categories"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "raw": "{{baseUrl}}/api/categories"
            },
            "method": "GET",
            "header": [],
            "description": "Lista categorías disponibles en Odoo."
          },
          "name": "Listar categorías"
        }
      ],
      "name": "01. Catálogo"
    },
    {
      "description": "Autenticación y consultas protegidas. Ejecuta Login primero para guardar jwt_token.",
      "item": [
        {
          "request": {
            "body": {
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "mode": "raw",
              "raw": "{\"name\":\"Juan Perez\",\"email\":\"juan.perez@ejemplo.com\",\"password\":\"Password123!\",\"province\":\"Pichincha\",\"phone\":\"0991234567\"}"
            },
            "url": {
              "path": [
                "api",
                "auth",
                "register"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "raw": "{{baseUrl}}/api/auth/register"
            },
            "method": "POST",
            "header": [
              {
                "value": "application/json",
                "key": "Content-Type"
              }
            ],
            "description": "Crea un cliente y sincroniza el contacto con Odoo. Usa un email nuevo. El registro devuelve el cliente, no un token; luego ejecuta Login."
          },
          "name": "Registrar cliente"
        },
        {
          "request": {
            "body": {
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "mode": "raw",
              "raw": "{\"email\":\"juan.perez@ejemplo.com\",\"password\":\"Password123!\"}"
            },
            "url": {
              "path": [
                "api",
                "auth",
                "login"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "raw": "{{baseUrl}}/api/auth/login"
            },
            "method": "POST",
            "header": [
              {
                "value": "application/json",
                "key": "Content-Type"
              }
            ],
            "description": "Guarda automáticamente token en jwt_token para las solicitudes protegidas."
          },
          "name": "Iniciar sesión",
          "event": [
            {
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  if (data.token) pm.collectionVariables.set(\"jwt_token\", data.token);",
                  "}"
                ]
              },
              "listen": "test"
            }
          ]
        },
        {
          "request": {
            "url": {
              "path": [
                "api",
                "customer",
                "features"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "raw": "{{baseUrl}}/api/customer/features"
            },
            "method": "GET",
            "header": [
              {
                "value": "Bearer {{jwt_token}}",
                "key": "Authorization"
              }
            ],
            "description": "Consulta funciones de la cuenta y puede refrescar estados observados de pedidos o generar notificaciones al detectar cambios. Reemplaza la antigua ruta /api/auth/me."
          },
          "name": "Consultar datos y funciones de la cuenta"
        },
        {
          "request": {
            "url": {
              "path": [
                "api",
                "cart"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "raw": "{{baseUrl}}/api/cart"
            },
            "method": "GET",
            "header": [
              {
                "value": "Bearer {{jwt_token}}",
                "key": "Authorization"
              }
            ],
            "description": "Consulta el carrito persistido del cliente autenticado."
          },
          "name": "Consultar carrito de la cuenta"
        },
        {
          "request": {
            "url": {
              "path": [
                "api",
                "payments",
                "history"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "raw": "{{baseUrl}}/api/payments/history"
            },
            "method": "GET",
            "header": [
              {
                "value": "Bearer {{jwt_token}}",
                "key": "Authorization"
              }
            ],
            "description": "Lista intentos de pago del cliente autenticado."
          },
          "name": "Historial de pagos"
        }
      ],
      "name": "02. Cuenta, carrito y pagos"
    },
    {
      "description": "El checkout crea una cotización y un PaymentIntent de prueba. No se dispara una confirmación/cargo automáticamente.",
      "item": [
        {
          "request": {
            "body": {
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "mode": "raw",
              "raw": "{\"items\":[{\"productId\":{{productId}},\"quantity\":1}]}"
            },
            "url": {
              "path": [
                "api",
                "checkout",
                "payments"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "raw": "{{baseUrl}}/api/checkout/payments"
            },
            "method": "POST",
            "header": [
              {
                "value": "application/json",
                "key": "Content-Type"
              },
              {
                "value": "Bearer {{jwt_token}}",
                "key": "Authorization"
              }
            ],
            "description": "Crea una cotización en Odoo y un PaymentIntent de prueba. No confirma ni cobra el pago por sí sola; confirmar el pago requiere el SDK Stripe. Usa un productId existente."
          },
          "name": "Iniciar checkout (crea cotización e intento de prueba)",
          "event": [
            {
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  if (data.attemptId) pm.collectionVariables.set(\"attemptId\", data.attemptId);",
                  "}"
                ]
              },
              "listen": "test"
            }
          ]
        },
        {
          "request": {
            "url": {
              "path": [
                "api",
                "checkout",
                "payments",
                "{{attemptId}}"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "raw": "{{baseUrl}}/api/checkout/payments/{{attemptId}}"
            },
            "method": "GET",
            "header": [
              {
                "value": "Bearer {{jwt_token}}",
                "key": "Authorization"
              }
            ],
            "description": "Usa attemptId guardado al iniciar checkout. El estado cambia cuando Stripe envía el webhook firmado."
          },
          "name": "Consultar estado del intento"
        },
        {
          "request": {
            "url": {
              "path": [
                "api",
                "orders"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "raw": "{{baseUrl}}/api/orders"
            },
            "method": "GET",
            "header": [
              {
                "value": "Bearer {{jwt_token}}",
                "key": "Authorization"
              }
            ],
            "description": "Lista únicamente pedidos del cliente autenticado."
          },
          "name": "Listar pedidos confirmados"
        },
        {
          "request": {
            "url": {
              "path": [
                "api",
                "orders",
                "{{orderId}}"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "raw": "{{baseUrl}}/api/orders/{{orderId}}"
            },
            "method": "GET",
            "header": [
              {
                "value": "Bearer {{jwt_token}}",
                "key": "Authorization"
              }
            ],
            "description": "Reemplaza orderId por un pedido propio existente."
          },
          "name": "Detalle de pedido"
        }
      ],
      "name": "03. Checkout y pedidos"
    },
    {
      "description": "Consultas de reseñas y compras elegibles.",
      "item": [
        {
          "request": {
            "url": {
              "path": [
                "api",
                "customer",
                "features",
                "products",
                "{{productId}}",
                "reviews"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "raw": "{{baseUrl}}/api/customer/features/products/{{productId}}/reviews"
            },
            "method": "GET",
            "header": [],
            "description": "Consulta reseñas visibles para el producto indicado."
          },
          "name": "Listar reseñas públicas de producto"
        },
        {
          "request": {
            "url": {
              "path": [
                "api",
                "customer",
                "features",
                "products",
                "{{productId}}",
                "review-order"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "raw": "{{baseUrl}}/api/customer/features/products/{{productId}}/review-order"
            },
            "method": "GET",
            "header": [
              {
                "value": "Bearer {{jwt_token}}",
                "key": "Authorization"
              }
            ],
            "description": "Devuelve el ID de un pedido propio confirmado que incluya el producto, si existe."
          },
          "name": "Buscar pedido elegible para reseña"
        }
      ],
      "name": "04. Funciones de cliente"
    }
